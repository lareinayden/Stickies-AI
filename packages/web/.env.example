# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stickies_ai
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_MAX_RETRIES=3
WHISPER_RETRY_DELAY=1000
WHISPER_TIMEOUT=60000

# Task Summarizer Configuration (optional)
TASK_SUMMARIZER_MODEL=gpt-4o-mini
TASK_SUMMARIZER_TEMPERATURE=0.3

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for authentication)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: allow mock users (shirley, yixiao, guest) via X-User-Id header for local testing without Supabase
# ALLOW_MOCK_USERS=true
